# Copy to .env and fill in. Never commit .env.
# Generate a key with: python -m app.crypto
MINISEAL_SIGNING_KEY=

# API keys are not configured here: they live (hashed) in the database.
# Create one with:  python -m app.auth create <owner>
# The key is printed once. Send it as the X-API-Key header.

# Self-service sign-up in the web app (POST /signup). Off by default:
# there is no email check or rate limit behind it.
# MINISEAL_OPEN_SIGNUP=true
